    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.2",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.173",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
